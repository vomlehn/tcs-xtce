#!/usr/bin/env python3
"""Run the reader in one language on what the writer in another wrote.

usage: to-from TO FROM

TO is the language whose program reads, FROM the language whose program
writes. Each is c, c++, rust or python. to-from prints "to: TO from: FROM",
then runs FROM's program as "write" and TO's as "read", with the writer's
standard output piped to the reader's standard input. The reader prints the
words it reads. to-from exits with status 1 if either program fails.

Build the programs first with "make build".
"""

import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
TOP = os.path.join(HERE, "..", "..")

# The command that runs each language's program, before its argument.
PROGRAMS = {
    "c": [os.path.join(HERE, "build", "to_from_c")],
    "c++": [os.path.join(HERE, "build", "to_from_cxx")],
    "rust": [os.path.join(HERE, "rust", "target", "release", "to-from")],
    "python": [sys.executable, os.path.join(HERE, "python", "main.py")],
}


def usage() -> None:
    sys.stderr.write(f"usage: to-from TO FROM   (each one of: {', '.join(PROGRAMS)})\n")
    sys.exit(2)


def main() -> None:
    if len(sys.argv) != 3 or not all(a in PROGRAMS for a in sys.argv[1:]):
        usage()
    to, from_ = sys.argv[1:]
    print(f"to: {to} from: {from_}", flush=True)

    for lang in (to, from_):
        program = PROGRAMS[lang][-1]
        if not os.path.exists(program):
            sys.exit(f"to-from: {program} is missing; run \"make build\" first")

    # The Python program needs the xtce package and its generated code.
    env = dict(os.environ)
    env["PYTHONPATH"] = os.pathsep.join(
        [os.path.join(TOP, "python"), os.path.join(HERE, "python")]
        + ([env["PYTHONPATH"]] if env.get("PYTHONPATH") else [])
    )

    writer = subprocess.Popen(PROGRAMS[from_] + ["write"], stdout=subprocess.PIPE, env=env)
    reader = subprocess.Popen(PROGRAMS[to] + ["read"], stdin=writer.stdout, env=env)
    # Only the reader holds the pipe now, so it sees the end of the input
    # when the writer exits.
    writer.stdout.close()
    read_status = reader.wait()
    write_status = writer.wait()

    if write_status != 0:
        sys.exit(f"to-from: the {from_} writer failed (status {write_status})")
    if read_status != 0:
        sys.exit(f"to-from: the {to} reader failed (status {read_status})")


if __name__ == "__main__":
    main()
