# Builds the C/C++ XTCE library (static and shared) and its tests.
#
# include/xtce-generated.hpp and src/generated.cpp are produced from the XTCE
# schema by the top-level `make generate`.

CXX      ?= g++
CC       ?= gcc
CXXFLAGS ?= -O2 -g
CFLAGS   ?= -O2 -g
CXXSTD   := -std=c++20
WARN     := -Wall -Wextra
BUILD    := build
SAMPLES  := $(sort $(wildcard ../tests/samples/*.xml))

LIB_SRCS := src/xml.cpp src/generated.cpp src/c_api.cpp
LIB_OBJS := $(LIB_SRCS:src/%.cpp=$(BUILD)/%.o)
HEADERS  := $(wildcard include/*.hpp include/*.h)

# The shared library's ABI version, which its soname carries: a program
# linked against libxtce.so.N keeps working with any library of that soname.
# It is kept in abi-version, and the top-level Makefile reads the same file
# for the names it installs, so the two cannot disagree. It is not the
# package's version, and is raised by one only when a change breaks
# programs already linked against the library: a function of xtce.h
# removed, or given other parameters or another meaning, or a C++ type of
# xtce-*.hpp changed in size or layout. Adding a function does not raise it.
ABI      := $(shell cat abi-version)
SONAME   := libxtce.so.$(ABI)

.PHONY: all
all: lib $(BUILD)/xtce_roundtrip $(BUILD)/packet_tool $(BUILD)/packet_tool_cxx \
     $(BUILD)/digest_tool $(BUILD)/digest_tool_cxx $(BUILD)/float_tool \
     $(BUILD)/float_tool_cxx $(BUILD)/stream_tool $(BUILD)/stream_tool_cxx \
     $(BUILD)/bnum_tool $(BUILD)/bnum_tool_cxx $(BUILD)/bnum_tool_hpp

.PHONY: lib
lib: $(BUILD)/libxtce.a $(BUILD)/libxtce.so

$(BUILD)/%.o: src/%.cpp $(HEADERS) | $(BUILD)
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -fPIC -Iinclude -c $< -o $@

$(BUILD)/libxtce.a: $(LIB_OBJS)
	$(AR) rcs $@ $^

$(BUILD)/libxtce.so: $(LIB_OBJS) abi-version
	$(CXX) -shared -Wl,-soname,$(SONAME) -o $@ $(LIB_OBJS)

$(BUILD)/xtce_roundtrip: tests/xtce_roundtrip.cpp $(BUILD)/libxtce.a
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude $< $(BUILD)/libxtce.a \
		-o $@

$(BUILD)/roundtrip_test: tests/roundtrip_test.cpp $(BUILD)/libxtce.a
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude $< $(BUILD)/libxtce.a \
		-o $@

# Packet codecs generated by tcs-xtce from tests/mission/demo.xml.  The
# generated header and its runtime xtce-packet.h are plain C that also
# compiles as C++, so each program is built both ways.
PKT_DEPS := tests/mission/demo.h include/xtce-packet.h

$(BUILD)/packet_tool: tests/packet_tool.c $(PKT_DEPS) | $(BUILD)
	$(CC) -std=c11 $(CFLAGS) $(WARN) -Iinclude -Itests $< -lm -o $@

$(BUILD)/packet_tool_cxx: tests/packet_tool.c $(PKT_DEPS) | $(BUILD)
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude -Itests -x c++ $< -o $@

$(BUILD)/stream_tool: tests/stream_tool.c $(PKT_DEPS) | $(BUILD)
	$(CC) -std=c11 $(CFLAGS) $(WARN) -Iinclude -Itests $< -lm -o $@

$(BUILD)/stream_tool_cxx: tests/stream_tool.c $(PKT_DEPS) | $(BUILD)
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude -Itests -x c++ $< -o $@

$(BUILD)/packet_test: tests/packet_test.c $(PKT_DEPS) | $(BUILD)
	$(CC) -std=c11 $(CFLAGS) $(WARN) -Iinclude -Itests $< -lm -o $@

$(BUILD)/packet_test_cxx: tests/packet_test.c $(PKT_DEPS) | $(BUILD)
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude -Itests -x c++ $< -o $@

# The XTCE digest, from the header xtce-digest.h alone, built both ways.
$(BUILD)/digest_tool: tests/digest_tool.c include/xtce-digest.h | $(BUILD)
	$(CC) -std=c11 $(CFLAGS) $(WARN) -Iinclude $< -o $@

$(BUILD)/digest_tool_cxx: tests/digest_tool.c include/xtce-digest.h | $(BUILD)
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude -x c++ $< -o $@

# Float conversions, from the header xtce-packet.h alone, built both ways.
$(BUILD)/float_tool: tests/float_tool.c include/xtce-packet.h | $(BUILD)
	$(CC) -std=c11 $(CFLAGS) $(WARN) -Iinclude $< -lm -o $@

$(BUILD)/float_tool_cxx: tests/float_tool.c include/xtce-packet.h | $(BUILD)
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude -x c++ $< -o $@

# Integers of any size: xtce-bnum.h built both ways, and xtce-bnum.hpp.
$(BUILD)/bnum_tool: tests/bnum_tool.c include/xtce-bnum.h | $(BUILD)
	$(CC) -std=c11 $(CFLAGS) $(WARN) -Iinclude $< -o $@

$(BUILD)/bnum_tool_cxx: tests/bnum_tool.c include/xtce-bnum.h | $(BUILD)
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude -x c++ $< -o $@

$(BUILD)/bnum_tool_hpp: tests/bnum_tool.cpp include/xtce-bnum.h \
    include/xtce-bnum.hpp | $(BUILD)
	$(CXX) $(CXXSTD) $(CXXFLAGS) $(WARN) -Iinclude $< -o $@

# The C test is compiled as C and linked with the C++ runtime.
$(BUILD)/c_api_test: tests/c_api_test.c $(BUILD)/libxtce.a
	$(CC) -std=c11 -D_GNU_SOURCE $(CFLAGS) $(WARN) -Iinclude -c $< \
		-o $(BUILD)/c_api_test.o
	$(CXX) $(BUILD)/c_api_test.o $(BUILD)/libxtce.a -o $@

.PHONY: test
test: $(BUILD)/roundtrip_test $(BUILD)/c_api_test $(BUILD)/packet_test \
      $(BUILD)/packet_test_cxx
	$(BUILD)/roundtrip_test $(SAMPLES)
	$(BUILD)/c_api_test
	$(BUILD)/packet_test
	$(BUILD)/packet_test_cxx

$(BUILD):
	mkdir -p $@

.PHONY: clean
clean:
	rm -rf $(BUILD)
