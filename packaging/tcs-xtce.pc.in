# The C/C++ XTCE library, ground software, installed by `make install` with
# @PREFIX@ and @VERSION@ replaced by the prefix it installed under and the
# package's version. The library is C++, so a program linking the static
# one, as `pkg-config --static` asks, needs the C++ runtime too. It takes
# the packet runtime, tcsxtce.pc, with it.
prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: tcs-xtce
Description: XTCE documents and their digests for C and C++ (tcs-xtce)
URL: https://github.com/vomlehn/tcs-xtce
Version: @VERSION@
Requires: tcsxtce = @VERSION@
Libs: -L${libdir} -ltcs-xtce -lm
Libs.private: -lstdc++ -lm
Cflags: -I${includedir}
