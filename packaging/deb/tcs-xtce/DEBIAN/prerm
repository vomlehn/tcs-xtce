#!/bin/sh
# Takes away the links tcs-xtce-links may have made in /usr/local/bin or
# /opt/bin, so that removing the package leaves none pointing at nothing.
# Done before the files go, rather than in postrm, because tcs-xtce-links is
# one of them; dpkg runs prerm with "remove" for a removal and for a purge
# alike, purge coming later and only to postrm. Not on an upgrade, which
# keeps the programs and so the links.
# A directory that is not there, or a link that is not ours, is no reason
# to stop a removal.
set -e
case "$1" in
remove)
	for dir in /usr/local/bin /opt/bin; do
		/opt/tcs/sbin/tcs-xtce-links --remove --dir "$dir" \
			> /dev/null 2>&1 || true
	done
	;;
esac
