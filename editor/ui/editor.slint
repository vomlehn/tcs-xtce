// The XTCE editor's windows.
//
// One window per document, its menus above two tabs.  The Structure tab
// is the document as one outline: an open element shows, one row deeper,
// its attributes as fields edited in place, its value, its comments and
// the elements in it, and what is wrong with a row is written under it;
// resting the pointer on a name shows what the schema says of it.  The
// Source tab shows the document's text, which can be edited and applied
// as a whole.  Below the tabs are the document's problems, a click on one
// selecting the element it is about, and the status line.  The other
// windows are here too: packet layouts, encoding and decoding, a
// conversion's dialog, text such as a digest, and questions.  Colour
// never carries a meaning alone: every mark that is coloured also says
// what it is in words or a symbol, and the colours are the Okabe-Ito
// palette, which colour-blind readers can tell apart.

import {
    Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, TabWidget,
    TextEdit, VerticalBox, HorizontalBox, GroupBox
} from "std-widgets.slint";

// The colours, each paired everywhere with a word or a symbol.
export global Palette {
    // A window's background, white as every TCS window's is.
    out property <color> window: #ffffff;
    // Errors: vermillion.
    out property <color> error: #D55E00;
    // Warnings: reddish purple.
    out property <color> warning: #CC79A7;
    // The selected row: sky blue.
    out property <color> selected: #56B4E9;
    // Comments in the outline: bluish green.
    out property <color> comment: #009E73;
    // Fields in a packet's layout, alternating blue and orange.
    out property <color> field-a: #0072B2;
    out property <color> field-b: #E69F00;
    // A text field's border, and its border when it has the focus, which
    // its text cursor shows too.
    out property <color> border: #8c8c8c;
    out property <color> border-focus: #0072B2;
    // What an empty field says it would hold.
    out property <color> hint: #6e6e6e;
}

// One row of the outline: an element, one of its attributes, its value, a
// comment, or the row that adds an attribute.
export struct Row {
    // Its place among the rows, which a selection by dragging is made of.
    index: int,
    // The element's or comment's id in the document; for an attribute, the
    // value or the adding row, the element's.
    id: int,
    // How deep it is: 0 for the root.  An element's attributes, value and
    // children are one deeper than it.
    depth: int,
    // "element", "comment", "attr", "value" or "add".
    kind: string,
    // What the row says: the element's name and its name attribute, the
    // attribute's name, or "value".
    label: string,
    // The attribute's, value's or comment's text, to edit.
    value: string,
    // What an empty field says: "(not given)", or a default.
    placeholder: string,
    // The values it may have, if they are a list; for the adding row, the
    // attributes that may be added.  Empty otherwise.
    choices: [string],
    // What the schema says it is, shown when the pointer rests on its
    // name.
    doc: string,
    // What is wrong with it, if anything.
    problem: string,
    // "error" or "warning", the worse of what is wrong with it, or "" if
    // nothing is.
    problem-severity: string,
    // Whether an element's attributes and children are shown.
    open: bool,
    // Whether an element has anything to show.
    has-kids: bool,
    // "error", "warning" or "" for the worst problem in an element.
    mark: string,
    // Whether it is the row the menus act on.
    selected: bool,
    // Whether it is among the rows selected together.
    marked: bool,
    // Whether the schema requires an attribute.
    required: bool,
    // Whether the element gives an attribute.
    present: bool,
    // Whether an attribute is a reference, which can be followed.
    is-ref: bool,
}

// One problem, or one usage of a definition.
export struct ProblemRow {
    // The element it is in.
    id: int,
    // "error", "warning" or "usage".
    severity: string,
    // What it says.
    text: string,
}

// Something that can be put in: an element or a ready-made part.
export struct Choice {
    // What the menu says.
    title: string,
    // Which one: the declaration's or the template's index.
    index: int,
    // What it is.
    about: string,
}

// One question a conversion asks.
export struct NeedRow {
    // What names it.
    key: string,
    // The question.
    question: string,
    // The answer given so far, or the suggestion.
    answer: string,
}

// One field of a packet's layout.
export struct FieldRow {
    // Its name.
    name: string,
    // The bits it takes.
    bits: int,
    // Where it starts, in bits from the packet's start.
    offset: int,
    // What the report says about it.
    note: string,
}

// One packet's layout.
export struct PacketRow {
    // The packet's heading.
    name: string,
    // Its size, as the report says it.
    size: string,
    // Its fields, in order.
    fields: [FieldRow],
    // The bits all its fields take.
    total: int,
}

// A mark that says in a word what its colour shows.
component Mark inherits Rectangle {
    in property <string> mark;
    width: self.mark == "" ? 0px : 18px;
    height: 16px;
    border-radius: 3px;
    background: self.mark == "error" ? Palette.error
        : self.mark == "warning" ? Palette.warning : transparent;
    Text {
        text: root.mark == "error" ? "E" : root.mark == "warning" ? "W" : "";
        color: white;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A text field one line high that grows a line at a time as its text
// wraps, so that a short value takes little room and a long one is all in
// view.  The standard LineEdit is a fixed height with generous padding,
// which in a list of attributes left more space than text.
component Field inherits Rectangle {
    // What it holds when shown.
    in property <string> value;
    // What it says when empty.
    in property <string> placeholder;
    // Whether Enter sets it, rather than starting a new line; Ctrl+Enter
    // sets either.
    in property <bool> one-line: true;
    // What it holds now, as edited.
    out property <string> text: input.text;
    // Enter was pressed in a one-line field.
    callback accepted(string);
    min-width: 120px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    height: max(input.preferred-height, hint.preferred-height) + 6px;
    border-width: 1px;
    border-radius: 3px;
    border-color: input.has-focus ? Palette.border-focus : Palette.border;
    background: Palette.window;
    forward-focus: input;
    hint := Text {
        x: 6px;
        y: 3px;
        text: input.text == "" ? root.placeholder : "";
        color: Palette.hint;
    }
    input := TextInput {
        x: 6px;
        y: 3px;
        width: parent.width - 12px;
        text: root.value;
        single-line: false;
        wrap: word-wrap;
        key-pressed(e) => {
            if (e.text == Key.Return
                    && (root.one-line || e.modifiers.control)) {
                root.accepted(self.text);
                return accept;
            }
            return reject;
        }
    }
}

// A choice among a list of values, one line high like a Field, with the
// list dropped below it.  The standard ComboBox is as tall as a LineEdit.
component Choices inherits Rectangle {
    // The values that may be chosen.
    in property <[string]> model;
    // The value shown.
    in property <string> current;
    // A value was chosen from the list.
    callback selected(string);
    min-width: 120px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    height: shown.preferred-height + 6px;
    border-width: 1px;
    border-radius: 3px;
    border-color: Palette.border;
    background: Palette.window;
    shown := Text {
        x: 6px;
        y: 3px;
        width: parent.width - 24px;
        text: root.current;
        overflow: elide;
    }
    // The arrow says, without colour, that this is a list.
    Text {
        x: parent.width - 16px;
        y: 3px;
        text: "\u{25BE}";
    }
    TouchArea {
        clicked => { list.show(); }
    }
    list := PopupWindow {
        x: 0px;
        y: root.height;
        width: root.width;
        Rectangle {
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.window;
            VerticalLayout {
                padding: 1px;
                for v in root.model: Rectangle {
                    height: item.preferred-height + 4px;
                    background: pick.has-hover ? Palette.selected
                        : transparent;
                    item := Text {
                        x: 6px;
                        text: v + (v == root.current ? "  (now)" : "");
                        vertical-alignment: center;
                    }
                    pick := TouchArea {
                        clicked => { root.selected(v); }
                    }
                }
            }
        }
    }
}

// A small button, one line high like a Field.
component Small inherits Rectangle {
    // What it says.
    in property <string> text;
    // It was clicked.
    callback clicked();
    width: label.preferred-width + 12px;
    height: label.preferred-height + 6px;
    border-width: 1px;
    border-radius: 3px;
    border-color: Palette.border;
    background: touch.has-hover ? Palette.selected : Palette.window;
    label := Text {
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One row of the outline.  Pressing on its name and dragging selects the
// rows dragged across, or, on a selected row, opens or closes the
// selection to a depth; the row reports where the pointer is in the
// outline's coordinates, which it shares with every other row.
component TreeRow inherits Rectangle {
    in property <Row> item;
    // The width of one level of indentation.
    in property <length> indent;
    // Whether a drag is selecting this row.
    in property <bool> swept;
    // The pointer was pressed on the row's name, at a place in the outline.
    callback press(int, length, length, bool, bool);
    // The pointer moved, still pressed, to a place in the outline.
    callback drag(length, length);
    // The pointer was let go.
    callback release();
    // The pointer rests on, or left, a name: what it says, and where.
    callback hover(string, length, length);
    callback unhover();
    callback toggle(int);
    callback set-attr(int, string, string);
    callback remove-attr(int, string);
    callback add-attr(int, string);
    callback follow(int, string);
    callback set-value(int, string);
    callback set-comment(int, string);
    property <bool> is-element: root.item.kind == "element";
    property <bool> is-comment: root.item.kind == "comment";
    property <bool> has-field: root.item.kind == "attr"
        || root.item.kind == "value";
    // Selection is said by the background and, so as not to be colour
    // alone, by a bar at the row's left edge.
    background: root.item.selected || root.item.marked || root.swept
        ? Palette.selected : transparent;
    min-height: 22px;
    if root.item.marked || root.swept: Rectangle {
        x: 0px;
        width: 3px;
        background: black;
    }
    VerticalLayout {
        // One level more than its depth, which leaves a gutter at the
        // left for the line that marks the selection and its handle.
        padding-left: (root.item.depth + 1) * root.indent;
        padding-top: 1px;
        padding-bottom: 1px;
        HorizontalLayout {
            spacing: 4px;
            // The disclosure triangle says open or closed by its shape.
            Rectangle {
                width: 16px;
                Text {
                    text: !root.item.has-kids ? ""
                        : root.item.open ? "▾" : "▸";
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.toggle(root.item.id); } }
            }
            Mark { mark: root.item.mark; y: 3px; }
            // The name, which is where a selection or a depth is dragged
            // from and where the schema's description is shown.
            name := Rectangle {
                width: root.is-element || root.is-comment
                    ? label.preferred-width + 8px : 200px;
                horizontal-stretch: 0;
                label := Text {
                    x: 0px;
                    text: root.is-comment ? "comment" : root.item.label
                        + (root.item.required ? " (required)" : "");
                    font-weight: root.is-element
                        || (root.item.kind == "attr" && root.item.present)
                        ? 700 : 400;
                    font-italic: root.is-comment;
                    color: root.is-comment ? Palette.comment : black;
                    vertical-alignment: center;
                    overflow: elide;
                }
                touch := TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down
                                && e.button == PointerEventButton.left) {
                            root.press(root.item.index,
                                root.x + self.absolute-position.x
                                    - root.absolute-position.x
                                    + self.mouse-x,
                                root.y + self.mouse-y,
                                e.modifiers.shift, e.modifiers.control);
                        } else if (e.kind == PointerEventKind.up
                                && e.button == PointerEventButton.left) {
                            root.release();
                        }
                    }
                    moved => {
                        root.drag(
                            root.x + self.absolute-position.x
                                - root.absolute-position.x + self.mouse-x,
                            root.y + self.mouse-y);
                    }
                    changed has-hover => {
                        if (self.has-hover && root.item.doc != "") {
                            root.hover(root.item.doc,
                                self.absolute-position.x,
                                self.absolute-position.y + self.height);
                        } else {
                            root.unhover();
                        }
                    }
                }
            }
            if root.has-field && root.item.choices.length > 0: Choices {
                model: root.item.choices;
                current: root.item.value;
                selected(v) => {
                    root.set-attr(root.item.id, root.item.label, v);
                }
            }
            if root.has-field && root.item.choices.length == 0: Field {
                value: root.item.value;
                placeholder: root.item.placeholder;
                accepted(t) => {
                    if (root.item.kind == "value") {
                        root.set-value(root.item.id, t);
                    } else {
                        root.set-attr(root.item.id, root.item.label, t);
                    }
                }
            }
            // A comment is lines, so Enter starts one and Ctrl+Enter, or
            // the button, sets it.
            if root.is-comment: HorizontalLayout {
                spacing: 4px;
                comment := Field {
                    value: root.item.value;
                    one-line: false;
                    accepted(t) => { root.set-comment(root.item.id, t); }
                }
                Small {
                    text: "Set";
                    clicked => {
                        root.set-comment(root.item.id, comment.text);
                    }
                }
            }
            if root.item.kind == "add": Choices {
                model: root.item.choices;
                current: "add an attribute";
                selected(v) => { root.add-attr(root.item.id, v); }
            }
            if root.item.is-ref && root.item.present: Small {
                text: "Go to";
                clicked => { root.follow(root.item.id, root.item.label); }
            }
            if root.item.kind == "attr" && !root.item.required: Small {
                text: "Remove";
                clicked => {
                    root.remove-attr(root.item.id, root.item.label);
                }
            }
            // An element's own row takes what width is left, so that its
            // fields line up on the right.
            if root.is-element: Rectangle { horizontal-stretch: 1; }
        }
        // What is wrong, marked E for an error or W for a warning as the
        // rows and the problems are, so the letter says which, not the
        // colour alone.
        if root.item.problem != "": HorizontalLayout {
            spacing: 6px;
            Mark {
                mark: root.item.problem-severity;
                y: 1px;
            }
            Text {
                text: root.item.problem;
                color: root.item.problem-severity == "warning"
                    ? Palette.warning : Palette.error;
                wrap: word-wrap;
            }
        }
    }
}

// A document's window.
export component DocWindow inherits Window {
    in property <string> doc-title;
    in property <[Row]> rows;
    // The depth of the topmost selected element, where the line a depth
    // is dragged with starts, or -1 if no element is selected.
    in property <int> top-depth: -1;
    // The places of the first and last selected rows, or -1.
    in property <int> first-marked: -1;
    in property <int> last-marked: -1;
    in property <[ProblemRow]> problems;
    in property <string> problems-title: "Problems";
    in property <bool> has-element;
    in property <bool> is-comment;
    in property <[Choice]> inserts;
    in property <[Choice]> templates;
    in property <string> undo-label;
    in property <string> redo-label;
    in property <bool> autosave;
    in property <string> status;
    in-out property <string> source;
    in property <[string]> other-versions;
    in property <bool> is-definition;
    in property <string> version;
    in property <bool> dirty;

    callback new-doc();
    callback open-doc();
    callback add-doc();
    callback save();
    callback save-as();
    callback close-doc();
    callback toggle-autosave();
    callback undo();
    callback redo();
    // A row's name was clicked, with Shift or Ctrl held or not.
    callback pick(int, bool, bool);
    // Rows were selected by dragging from one to another, added to those
    // selected if Ctrl was held.
    callback mark-range(int, int, bool);
    // The selected elements are opened (true) or closed (false) to a
    // depth.
    callback depth-to(int, bool);
    callback toggle(int);
    callback set-attr(int, string, string);
    callback remove-attr(int, string);
    callback add-attr(int, string);
    callback follow(int, string);
    callback set-value(int, string);
    callback set-comment(int, string);
    callback add-comment();
    callback insert(int);
    callback insert-template(int);
    callback delete-selected();
    callback move-up();
    callback move-down();
    callback rename();
    callback find-usages();
    callback convert(string);
    callback load-source();
    callback apply-source(string);
    callback show-layout();
    callback show-tester();
    callback compare();
    callback digest();
    callback spec();
    callback pick-problem(int);

    title: (root.dirty ? "* " : "") + root.doc-title + " - XTCE "
        + root.version;
    preferred-width: 1200px;
    preferred-height: 800px;
    background: Palette.window;

    // The width of one level of the outline.
    property <length> indent: 20px;
    // What a drag on the outline is doing: 0 nothing, 1 selecting rows,
    // 2 opening or closing the selection to a depth with the handle.
    property <int> drag-mode: 0;
    // The row the drag started on, and the row the pointer is on now.
    property <int> anchor;
    property <int> reach;
    // Where the drag started and where the pointer is, in the outline.
    property <length> press-x;
    property <length> press-y;
    property <length> cur-x;
    property <length> cur-y;
    // Whether Shift and Ctrl were held when it started.
    property <bool> drag-shift;
    property <bool> drag-ctrl;
    // Whether the pointer has moved far enough to be a drag, not a click.
    property <bool> moved-far: abs(root.cur-x - root.press-x) > 4px
        || abs(root.cur-y - root.press-y) > 4px;
    // The depth whose column the pointer is nearest.
    property <int> target-depth:
        max(0, round((root.cur-x - root.bar-margin) / root.indent));
    // Whether a depth drag opens, being to the right of where it started.
    property <bool> opening: root.cur-x > root.press-x;
    // Where the selected rows start and end in the outline, as the first
    // and last of them report it.
    property <length> sel-top;
    property <length> sel-bottom;
    // Where in its level's gutter the line that marks the selection runs,
    // just before the element's disclosure triangle.
    property <length> bar-margin: 9px;
    // The column of the line that marks the selection: where the topmost
    // selected element starts.
    property <length> bar-x: root.top-depth * root.indent + root.bar-margin;
    // The description shown for a name, where, and whether it is wanted
    // and shown yet: it waits for the pointer to rest.
    property <string> tip;
    property <length> tip-x;
    property <length> tip-y;
    property <bool> tip-wanted;
    property <bool> tip-on;

    Timer {
        interval: 600ms;
        running: root.tip-wanted && !root.tip-on;
        triggered => { root.tip-on = true; }
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New document...";
                activated => { root.new-doc(); }
            }
            MenuItem { title: "Open..."; activated => { root.open-doc(); } }
            // A mission is several documents: one added here is opened in
            // a window of its own, and references between them resolve.
            MenuItem {
                title: "Add a document to the mission...";
                activated => { root.add-doc(); }
            }
            MenuSeparator { }
            MenuItem { title: "Save"; activated => { root.save(); } }
            MenuItem { title: "Save as..."; activated => { root.save-as(); } }
            MenuItem {
                title: root.autosave ? "Autosave: on (turn off)"
                    : "Autosave: off (turn on)";
                activated => { root.toggle-autosave(); }
            }
            MenuSeparator { }
            MenuItem { title: "Close"; activated => { root.close-doc(); } }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: root.undo-label == "" ? "Undo"
                    : "Undo " + root.undo-label;
                enabled: root.undo-label != "";
                activated => { root.undo(); }
            }
            MenuItem {
                title: root.redo-label == "" ? "Redo"
                    : "Redo " + root.redo-label;
                enabled: root.redo-label != "";
                activated => { root.redo(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Rename everywhere...";
                enabled: root.is-definition;
                activated => { root.rename(); }
            }
            MenuItem {
                title: "Find usages";
                enabled: root.is-definition;
                activated => { root.find-usages(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Move up";
                enabled: root.has-element;
                activated => { root.move-up(); }
            }
            MenuItem {
                title: "Move down";
                enabled: root.has-element;
                activated => { root.move-down(); }
            }
            MenuItem {
                title: "Delete";
                enabled: root.has-element || root.is-comment;
                activated => { root.delete-selected(); }
            }
            MenuItem {
                title: "Add a comment before";
                enabled: root.has-element;
                activated => { root.add-comment(); }
            }
        }
        Menu {
            title: "Insert";
            for c in root.inserts: MenuItem {
                title: c.title;
                activated => { root.insert(c.index); }
            }
            MenuSeparator { }
            for c in root.templates: MenuItem {
                title: "Ready-made: " + c.title;
                activated => { root.insert-template(c.index); }
            }
        }
        Menu {
            title: "Version";
            for v in root.other-versions: MenuItem {
                title: "Convert to XTCE " + v + "...";
                activated => { root.convert(v); }
            }
        }
        Menu {
            title: "Tools";
            MenuItem {
                title: "Packet layout";
                activated => { root.show-layout(); }
            }
            MenuItem {
                title: "Encode and decode...";
                activated => { root.show-tester(); }
            }
            MenuItem {
                title: "Compare with a file...";
                activated => { root.compare(); }
            }
            MenuItem { title: "Digest"; activated => { root.digest(); } }
            MenuItem {
                title: "Specification of this element";
                enabled: root.has-element;
                activated => { root.spec(); }
            }
        }
    }

    VerticalBox {
        TabWidget {
            Tab {
                title: "Structure";
                VerticalLayout {
                    padding: 4px;
                    spacing: 4px;
                    tree-view := ScrollView {
                        vertical-stretch: 1;
                        content-height: max(tree.preferred-height,
                            self.visible-height);
                        content-width: self.visible-width;
                        tree := VerticalLayout {
                            x: 0px;
                            y: 0px;
                            // Fluent's scroll bar is drawn over what it
                            // scrolls, 14px wide at the right, so the
                            // rows stop short of it.
                            width: tree-view.visible-width - 14px;
                            height: self.preferred-height;
                            alignment: start;
                            for r in root.rows: TreeRow {
                                item: r;
                                indent: root.indent;
                                // Whether the pointer is over this row in
                                // a drag that selects.
                                property <bool> under: root.drag-mode == 1
                                    && root.cur-y >= self.y
                                    && root.cur-y < self.y + self.height;
                                // The first and last selected rows say
                                // where the line marking the selection
                                // runs.
                                init => { self.report(); }
                                changed y => { self.report(); }
                                changed height => { self.report(); }
                                function report() {
                                    if (r.index == root.first-marked) {
                                        root.sel-top = self.y;
                                    }
                                    if (r.index == root.last-marked) {
                                        root.sel-bottom = self.y + self.height;
                                    }
                                }
                                changed under => {
                                    if (self.under) {
                                        root.reach = r.index;
                                    }
                                }
                                swept: root.drag-mode == 1 && root.moved-far
                                    && r.index >= min(root.anchor, root.reach)
                                    && r.index <= max(root.anchor, root.reach);
                                press(i, x, y, shift, ctrl) => {
                                    root.anchor = i;
                                    root.reach = i;
                                    root.press-x = x;
                                    root.cur-x = x;
                                    root.press-y = y;
                                    root.cur-y = y;
                                    root.drag-shift = shift;
                                    root.drag-ctrl = ctrl;
                                    root.tip-wanted = false;
                                    root.tip-on = false;
                                    root.drag-mode = 1;
                                }
                                drag(x, y) => {
                                    root.cur-x = x;
                                    root.cur-y = y;
                                }
                                release => {
                                    if (!root.moved-far) {
                                        root.pick(root.anchor,
                                            root.drag-shift, root.drag-ctrl);
                                    } else if (root.drag-mode == 1) {
                                        root.mark-range(root.anchor,
                                            root.reach, root.drag-ctrl);
                                    } else if (root.drag-mode == 2) {
                                        root.depth-to(root.target-depth,
                                            root.opening);
                                    }
                                    root.drag-mode = 0;
                                }
                                hover(doc, x, y) => {
                                    if (root.drag-mode == 0) {
                                        root.tip = doc;
                                        root.tip-x = x;
                                        root.tip-y = y;
                                        root.tip-on = false;
                                        root.tip-wanted = true;
                                    }
                                }
                                unhover => {
                                    root.tip-wanted = false;
                                    root.tip-on = false;
                                }
                                toggle(id) => { root.toggle(id); }
                                set-attr(id, n, v) => {
                                    root.set-attr(id, n, v);
                                }
                                remove-attr(id, n) => {
                                    root.remove-attr(id, n);
                                }
                                add-attr(id, n) => { root.add-attr(id, n); }
                                follow(id, n) => { root.follow(id, n); }
                                set-value(id, t) => { root.set-value(id, t); }
                                set-comment(id, t) => {
                                    root.set-comment(id, t);
                                }
                            }
                        }
                        // The line that marks the selection, down the
                        // column where its topmost element starts, and on
                        // it the handle that drags it to a depth: right to
                        // open, left to close.  While it is dragged, the
                        // line follows the depth under the pointer, and
                        // words say what letting go will do.
                        if root.first-marked >= 0 && root.top-depth >= 0
                                : Rectangle {
                            x: (root.drag-mode == 2
                                ? root.target-depth * root.indent
                                    + root.bar-margin
                                : root.bar-x) - 1px;
                            y: root.sel-top;
                            width: 3px;
                            height: max(0px, root.sel-bottom - root.sel-top);
                            background: root.drag-mode != 2 ? black
                                : root.opening ? Palette.field-a
                                : Palette.error;
                        }
                        if root.first-marked >= 0 && root.top-depth >= 0
                                : handle := Rectangle {
                            // The middle of the part of the line in view.
                            property <length> seen-top: max(root.sel-top,
                                -tree-view.content-y);
                            property <length> seen-bottom: min(
                                root.sel-bottom,
                                -tree-view.content-y
                                    + tree-view.visible-height);
                            width: 18px;
                            height: 18px;
                            x: (root.drag-mode == 2 ? root.cur-x : root.bar-x)
                                - 9px;
                            y: (self.seen-top + self.seen-bottom) / 2 - 9px;
                            visible: self.seen-bottom > self.seen-top;
                            border-width: 1px;
                            border-radius: 9px;
                            border-color: black;
                            background: grab.has-hover || root.drag-mode == 2
                                ? Palette.selected : Palette.window;
                            Text {
                                text: "↔";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            grab := TouchArea {
                                mouse-cursor: ew-resize;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        root.press-x = root.bar-x;
                                        root.cur-x = root.bar-x;
                                        root.press-y = 0px;
                                        root.cur-y = 0px;
                                        root.tip-wanted = false;
                                        root.tip-on = false;
                                        root.drag-mode = 2;
                                    } else if (e.kind == PointerEventKind.up
                                            && root.drag-mode == 2) {
                                        if (abs(root.cur-x - root.press-x)
                                                > 4px) {
                                            root.depth-to(root.target-depth,
                                                root.opening);
                                        }
                                        root.drag-mode = 0;
                                    }
                                }
                                moved => {
                                    root.cur-x = self.absolute-position.x
                                        + self.mouse-x
                                        - tree.absolute-position.x;
                                }
                            }
                        }
                        if root.drag-mode == 2
                                && abs(root.cur-x - root.press-x) > 4px
                                : Rectangle {
                            x: root.cur-x + 16px;
                            y: max(root.sel-top, -tree-view.content-y);
                            width: what.preferred-width + 10px;
                            height: what.preferred-height + 4px;
                            border-width: 1px;
                            border-color: Palette.border;
                            background: Palette.window;
                            what := Text {
                                text: (root.opening ? "open" : "close")
                                    + " to depth " + root.target-depth;
                            }
                        }
                    }
                    // While rows are selected by dragging past the top or
                    // the bottom of the outline, it scrolls, faster the
                    // further past the pointer is.
                    Timer {
                        property <length> top: -tree-view.content-y;
                        property <length> bottom: self.top
                            + tree-view.visible-height;
                        interval: 30ms;
                        running: root.drag-mode == 1
                            && (root.cur-y < self.top
                                || root.cur-y > self.bottom);
                        triggered => {
                            if (root.cur-y < self.top) {
                                let step = min(-tree-view.content-y,
                                    clamp((self.top - root.cur-y) / 2,
                                        4px, 40px));
                                tree-view.content-y += step;
                                root.cur-y -= step;
                            } else {
                                let step = min(
                                    tree-view.content-height
                                        - tree-view.visible-height
                                        + tree-view.content-y,
                                    clamp((root.cur-y - self.bottom) / 2,
                                        4px, 40px));
                                tree-view.content-y -= max(0px, step);
                                root.cur-y += max(0px, step);
                            }
                        }
                    }
                    Text {
                        text: "Enter in a field sets it (Ctrl+Enter in a "
                            + "comment).  Drag across names to select rows; "
                            + "drag the selection's \u{2194} handle right to "
                            + "open it, left to close it, to the depth under "
                            + "the pointer.";
                        wrap: word-wrap;
                        font-size: 11px;
                    }
                }
            }
            Tab {
                title: "Source";
                VerticalBox {
                    source-edit := TextEdit {
                        text <=> root.source;
                        font-family: "monospace";
                        vertical-stretch: 1;
                    }
                    HorizontalBox {
                        Button {
                            text: "Apply the source";
                            clicked => { root.apply-source(source-edit.text); }
                        }
                        Button {
                            text: "Show the document as it is";
                            clicked => { root.load-source(); }
                        }
                    }
                }
            }
        }
        // What is wrong, or what a search found.
        Text { text: root.problems-title; font-weight: 700; }
        ListView {
            height: 140px;
            for p in root.problems: Rectangle {
                height: 22px;
                HorizontalLayout {
                    spacing: 6px;
                    Mark {
                        mark: p.severity == "usage" ? "" : p.severity;
                        y: 3px;
                    }
                    Text {
                        text: (p.severity == "error" ? "Error: "
                            : p.severity == "warning" ? "Warning: "
                            : "Used in: ") + p.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                TouchArea { clicked => { root.pick-problem(p.id); } }
            }
        }
        Text { text: root.status; wrap: word-wrap; }
    }

    // The description of the name the pointer rests on, kept inside the
    // window and above the name when there is no room below it.
    if root.tip-on && root.tip != "": Rectangle {
        width: min(480px, root.width - 16px);
        height: tip-text.preferred-height + 12px;
        x: max(8px, min(root.tip-x, root.width - self.width - 8px));
        y: root.tip-y + 2px + self.height > root.height
            ? root.tip-y - 26px - self.height : root.tip-y + 2px;
        border-width: 1px;
        border-color: Palette.border;
        background: #f6f6f6;
        tip-text := Text {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            text: root.tip;
            wrap: word-wrap;
        }
    }
}

// A question with up to three answers.
export component AskDialog inherits Window {
    in property <string> message;
    in property <string> first: "OK";
    in property <string> second;
    in property <string> third;
    callback chosen(int);
    title: "XTCE editor";
    background: Palette.window;
    preferred-width: 520px;
    VerticalBox {
        // A width of its own, the window's less the box's padding, so
        // that its height is that of the text wrapped to it and a long
        // question is not cut off with the buttons below it.
        Text { text: root.message; wrap: word-wrap; width: 496px; }
        HorizontalBox {
            alignment: end;
            Button { text: root.first; clicked => { root.chosen(0); } }
            if root.second != "": Button {
                text: root.second;
                clicked => { root.chosen(1); }
            }
            if root.third != "": Button {
                text: root.third;
                clicked => { root.chosen(2); }
            }
        }
    }
}

// A question answered in words.
export component InputDialog inherits Window {
    in property <string> message;
    in-out property <string> answer;
    callback done(bool, string);
    title: "XTCE editor";
    background: Palette.window;
    preferred-width: 520px;
    VerticalBox {
        Text { text: root.message; wrap: word-wrap; }
        field := LineEdit {
            text <=> root.answer;
            accepted => { root.done(true, self.text); }
        }
        HorizontalBox {
            alignment: end;
            Button { text: "OK"; clicked => { root.done(true, field.text); } }
            Button { text: "Cancel"; clicked => { root.done(false, ""); } }
        }
    }
}

// Text to read: a comparison, a digest, a size report.
export component TextWindow inherits Window {
    in property <string> heading;
    in property <string> body;
    title: root.heading;
    background: Palette.window;
    preferred-width: 800px;
    preferred-height: 600px;
    VerticalBox {
        TextEdit {
            text: root.body;
            read-only: true;
            font-family: "monospace";
        }
    }
}

// What a conversion will do, and what it asks.
export component ConvertDialog inherits Window {
    in property <string> target;
    in property <string> summary;
    in property <[NeedRow]> needs;
    in property <bool> loses;
    in property <bool> refused;
    in-out property <bool> accept-loss;
    callback answer(string, string);
    callback go();
    callback cancel();
    title: "Convert to XTCE " + root.target;
    background: Palette.window;
    preferred-width: 760px;
    preferred-height: 560px;
    VerticalBox {
        TextEdit {
            text: root.summary;
            read-only: true;
            vertical-stretch: 1;
        }
        for n in root.needs: VerticalLayout {
            Text { text: n.question; wrap: word-wrap; }
            LineEdit {
                text: n.answer;
                edited(t) => { root.answer(n.key, t); }
            }
        }
        if root.loses: CheckBox {
            text: "Convert anyway, losing what is listed as lost";
            checked <=> root.accept-loss;
        }
        HorizontalBox {
            alignment: end;
            Button {
                text: root.needs.length > 0 ? "Try again with these answers"
                    : "Convert";
                enabled: !root.refused && (!root.loses || root.accept-loss
                    || root.needs.length > 0);
                clicked => { root.go(); }
            }
            Button { text: "Cancel"; clicked => { root.cancel(); } }
        }
    }
}

// Each packet's fields, drawn to scale, with their names and sizes written
// in each, so the drawing is read by its words as well as by its shading.
export component LayoutWindow inherits Window {
    in property <[PacketRow]> packets;
    in property <string> note;
    title: "Packet layout";
    background: Palette.window;
    preferred-width: 1000px;
    preferred-height: 640px;
    VerticalBox {
        Text { text: root.note; wrap: word-wrap; }
        ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 14px;
                for p in root.packets: VerticalLayout {
                    alignment: start;
                    spacing: 4px;
                    Text { text: p.name + ": " + p.size; font-weight: 700; }
                    bar := Rectangle {
                        height: 46px;
                        border-width: 1px;
                        border-color: black;
                        for f[i] in p.fields: Rectangle {
                            x: p.total == 0 ? 0px
                                : f.offset * (bar.width - 2px) / p.total + 1px;
                            width: p.total == 0 ? 0px : max(1px,
                                f.bits * (bar.width - 2px) / p.total);
                            y: 1px;
                            height: parent.height - 2px;
                            background: Math.mod(i, 2) == 0 ? Palette.field-a
                                : Palette.field-b;
                            border-width: 1px;
                            border-color: white;
                            Text {
                                text: f.name + "\n" + f.bits + " bit"
                                    + (f.bits == 1 ? "" : "s");
                                color: Math.mod(i, 2) == 0 ? white : black;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 11px;
                                overflow: elide;
                                width: parent.width - 2px;
                            }
                        }
                    }
                    for f in p.fields: Text {
                        text: "  bit " + f.offset + ": " + f.name + ", "
                            + f.bits + " bit" + (f.bits == 1 ? "" : "s")
                            + (f.note == "" ? "" : " (" + f.note + ")");
                        font-size: 12px;
                    }
                }
            }
        }
    }
}

// Encoding values into a packet, and decoding a packet's bytes, with the
// codecs the compiler generates.
export component TesterWindow inherits Window {
    in property <[string]> packets;
    in property <string> fields;
    in-out property <string> chosen;
    in-out property <string> values: "{}";
    in-out property <string> hex;
    in property <string> result;
    callback pick(string);
    callback encode(string, string);
    callback decode(string, string);
    title: "Encode and decode";
    background: Palette.window;
    preferred-width: 820px;
    preferred-height: 620px;
    VerticalBox {
        HorizontalBox {
            Text { text: "Packet"; vertical-alignment: center; }
            ComboBox {
                model: root.packets;
                current-value <=> root.chosen;
                selected(v) => { root.pick(v); }
                horizontal-stretch: 1;
            }
        }
        Text { text: root.fields; wrap: word-wrap; font-family: "monospace"; }
        Text { text: "Values, as JSON: field names as above"; }
        values-edit := TextEdit {
            text <=> root.values;
            font-family: "monospace";
            min-height: 100px;
        }
        HorizontalBox {
            Button {
                text: "Encode";
                clicked => { root.encode(root.chosen, values-edit.text); }
            }
        }
        Text { text: "Bytes, in hexadecimal"; }
        hex-edit := LineEdit { text <=> root.hex; font-family: "monospace"; }
        HorizontalBox {
            Button {
                text: "Decode";
                clicked => { root.decode(root.chosen, hex-edit.text); }
            }
        }
        TextEdit {
            text: root.result;
            read-only: true;
            font-family: "monospace";
            vertical-stretch: 1;
        }
    }
}
