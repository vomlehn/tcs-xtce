# The style of the C and C++ in this repository: Google's, with 8-space
# indents and an 80-column limit.  Format hand-written C and C++ with
# clang-format; the generators emit the same indentation.
BasedOnStyle: Google
ColumnLimit: 80
IndentWidth: 8
ContinuationIndentWidth: 8
ConstructorInitializerIndentWidth: 8
AccessModifierOffset: -8
UseTab: Never
